# ==========================================
# 1. Frontend (Node / React / Vite)
# ==========================================

# Standard dependencies
node_modules/

# Standard build output (e.g., Vite/Webpack/Rolup)
# Since Tauri bundles require a built frontend first.
dist/
dist-ssr/

# Temporary Vite directories
.vite/
.output/

# Testing coverage (if using Jest/Vitest)
coverage/

# Misc
.eslintcache
.pnpm-store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 2. Backend / Environment Secrets (CRUCIAL)
# ==========================================

# DO NOT COMMIT SENSITIVE KEYS
.env
.env.test
.env.local
.env.*.local

# Standard file local handling
*.local

# ==========================================
# 3. Rust / Cargo (MANDATORY ADDITIONS)
# ==========================================

# By far the most important addition.
# The `target` directory (typically inside src-tauri) contains
# gigabytes of compiled object files, dependencies, and temporary build data.
# Do not use `target/` alone; use relative paths because this .gitignore is in the root.
src-tauri/target/

# Backup files generated by Cargo/Rust tools
**/*.rs.bk

# Generated by Cargo when creating a package
*.crate

# ==========================================
# 4. Tauri Bundle Specifics
# ==========================================

# Standard location for Tauri CLI generated installer bundles
# It is best to recreate these artifacts from scratch rather than commit them.
src-tauri/gen/
src-tauri/bin/

# Temporary Tauri directories
src-tauri/.tauri/

# ==========================================
# 5. OS & Editor (User's original list, expanded)
# ==========================================

# macOS system files
.DS_Store

# Windows system files
Thumbs.db
desktop.ini

# VS Code specific
# We exclude everything in .vscode except extensions.json (recommended)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json # Helpful to commit debug setups, optionally ignore if strictly personal.

# IntelliJ (Idea) directories
.idea/

# General Visual Studio / C++ artifacts (relevant for Windows builds)
*.sln
*.suo
*.ntvs*
*.njsproj
*.user
*.userosscache
*.sln.docstates
_ReSharper.Caches/
*.sw?
*.bak
